{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "self",
    "substrate",
    "agents"
  ],
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 40
    },
    "repo": {
      "type": "object",
      "required": [
        "repoURL",
        "revision"
      ],
      "properties": {
        "repoURL": {
          "type": "string",
          "pattern": "^https://"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "type": {
          "enum": [
            "pr-agent"
          ],
          "description": "The only type today."
        },
        "atespace": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "namespace": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "actorName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "image": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "modelEndpoint": {
          "type": "string"
        },
        "fallbackModels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelApiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "metricsEndpoint": {
          "type": "string"
        },
        "metricsApiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "metricsCollector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "helmValues": {
              "type": "object"
            }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "metricsEnvironment": {
          "type": "string"
        },
        "contextLength": {
          "type": "integer",
          "minimum": 1
        },
        "runDetails": {
          "type": "boolean"
        },
        "largeReviews": {
          "type": "boolean"
        },
        "maxReviewCalls": {
          "type": "integer",
          "minimum": 1
        },
        "modelTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "workers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxWorkers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "retrySameModelOnTimeout": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "modelRetries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "gitlabUrl": {
          "type": "string"
        },
        "gitlabExtraUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hopToken": {
          "type": "string"
        },
        "egressTrustBundle": {
          "type": "boolean"
        },
        "cpuMillicores": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "webhook": {
          "type": "object"
        },
        "actorHelmValues": {
          "type": "object"
        },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "unregister": {
              "type": "boolean"
            },
            "helmValues": {
              "type": "object"
            }
          }
        },
        "idleSuspend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "prometheusUrl": {
              "type": "string"
            },
            "idleMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "schedule": {
              "type": "string"
            },
            "helmValues": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "properties": {
    "self": {
      "$ref": "#/definitions/repo"
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoURL",
        "revision",
        "installImageDigest",
        "namespace",
        "bucket"
      ],
      "properties": {
        "repoURL": {
          "type": "string",
          "pattern": "^https://"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "A full commit hash: the charts and the install image must agree."
        },
        "installImageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "namespace": {
          "enum": [
            "ate-system"
          ],
          "description": "Upstream installs only there."
        },
        "bucket": {
          "type": "string",
          "minLength": 3
        },
        "s3Endpoint": {
          "type": "string"
        },
        "selinuxLevel": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podMonitoringCrdStub": {
          "type": "boolean"
        },
        "podMonitorLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "install": {
          "type": "object"
        },
        "workers": {
          "type": "object"
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/agent"
      }
    },
    "clusterResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "kind"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      }
    }
  }
}
