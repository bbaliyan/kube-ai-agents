{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "project": {
      "type": "string"
    },
    "self": {
      "type": "object"
    },
    "substrate": {
      "type": "object"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "type": {
          "enum": [
            "pr-agent"
          ],
          "description": "The only type today."
        },
        "atespace": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "namespace": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "actorName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 40
        },
        "image": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "modelEndpoint": {
          "type": "string"
        },
        "fallbackModels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modelApiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "metricsEndpoint": {
          "type": "string"
        },
        "metricsApiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "metricsCollector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "helmValues": {
              "type": "object"
            }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "metricsEnvironment": {
          "type": "string"
        },
        "modelContextLengths": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "contextLength": {
          "type": "integer",
          "minimum": 1
        },
        "runDetails": {
          "type": "boolean"
        },
        "modelStreaming": {
          "type": "boolean"
        },
        "largeReviews": {
          "type": "boolean"
        },
        "maxReviewCalls": {
          "type": "integer",
          "minimum": 1
        },
        "modelTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "workers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maxWorkers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "retrySameModelOnTimeout": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "modelRetries": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "gitlabUrl": {
          "type": "string"
        },
        "globalSettingsRepo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$"
        },
        "useGroupSettingsFile": {
          "type": "boolean"
        },
        "gitlabExtraUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hopToken": {
          "type": "string"
        },
        "egressTrustBundle": {
          "type": "boolean"
        },
        "cpuMillicores": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "webhook": { "type": "object", "if": { "minProperties": 1 }, "then": { "required": ["allowFrom"], "properties": { "allowFrom": { "type": "array", "minItems": 1 } } } },
        "actorHelmValues": {
          "type": "object"
        },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "unregister": {
              "type": "boolean"
            },
            "helmValues": {
              "type": "object"
            }
          }
        },
        "idleSuspend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "prometheusUrl": {
              "type": "string"
            },
            "idleMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "schedule": {
              "type": "string"
            },
            "helmValues": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
