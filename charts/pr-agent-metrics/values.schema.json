{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "string"
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "generateToken": {
      "type": "boolean"
    },
    "otlpPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "metricsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "metricExpiration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h)$"
    },
    "allowOtlpFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allowScrapeFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sampleLimit": {
          "type": "integer",
          "minimum": 1
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        }
      }
    }
  }
}
