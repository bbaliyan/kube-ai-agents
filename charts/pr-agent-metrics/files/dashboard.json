{
  "title": "Agent: __NAME__",
  "uid": "ai-agent-__NAME__",
  "tags": [
    "ai-agent",
    "pr-agent"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Working right now?",
      "description": "Busy while the agent runs a command. Idle when it waits for work.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Idle",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 1000000,
                "result": {
                  "text": "Busy",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(pr_agent_commands_in_flight{ate_actor=\"__ACTOR__\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reviews started",
      "description": "Reviews that started in the time range at the top right of the dashboard. A command counts when it starts, so a review that failed counts too.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(((increase(pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]) + (min_over_time(pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]) unless pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} offset $__range)) or increase(pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]))) or vector(0)"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Commands failed",
      "description": "The share of commands that ended with an error, out of all that ended, in the time range at the top right of the dashboard. A command that was skipped does not count. Green is below 5 percent, orange up to 20 percent, red above that.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "noValue": "0%",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(((increase(pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"}[$__range]) + (min_over_time(pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"}[$__range]) unless pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"} offset $__range)) or increase(pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"}[$__range]))) / clamp_min(sum(((increase(pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\"}[$__range]) + (min_over_time(pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\"}[$__range]) unless pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\"} offset $__range)) or increase(pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\"}[$__range]))), 1)"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Answered by a fallback model",
      "description": "The share of commands that a fallback model answered because the main model failed or timed out, in the time range at the top right of the dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "noValue": "0%",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(((increase(pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\",fallback=\"true\"}[$__range]) + (min_over_time(pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\",fallback=\"true\"}[$__range]) unless pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\",fallback=\"true\"} offset $__range)) or increase(pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\",fallback=\"true\"}[$__range]))) / clamp_min(sum(((increase(pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"}[$__range]) + (min_over_time(pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"}[$__range]) unless pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"} offset $__range)) or increase(pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"}[$__range]))), 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Model calls per review",
      "description": "How many times the agent asked the model for one review. A big review is cut into chunks, so the number is higher. A dash means no review yet, in the time range at the top right of the dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(((increase(pr_agent_ai_calls_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]) + (min_over_time(pr_agent_ai_calls_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]) unless pr_agent_ai_calls_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} offset $__range)) or increase(pr_agent_ai_calls_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]))) / (sum(((increase(pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]) + (min_over_time(pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]) unless pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} offset $__range)) or increase(pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"}[$__range]))) > 0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tokens used",
      "description": "Tokens that the model read and wrote, in the time range at the top right of the dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(((increase(pr_agent_tokens_total{ate_actor=\"__ACTOR__\"}[$__range]) + (min_over_time(pr_agent_tokens_total{ate_actor=\"__ACTOR__\"}[$__range]) unless pr_agent_tokens_total{ate_actor=\"__ACTOR__\"} offset $__range)) or increase(pr_agent_tokens_total{ate_actor=\"__ACTOR__\"}[$__range]))) or vector(0)"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Work started",
      "description": "Reviews, descriptions and improvement suggestions that started. A bar covers the time slice that ends at its right edge, so it lines up with the busy time beside it. A command counts when it starts, so a long review shows at its start and the busy time shows how long it ran. Zoom out and the bars get wider.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": -1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum((((pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} - pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} offset $__interval) >= 0) or (pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} unless pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} offset $__interval) or (pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} < pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"review\"} offset $__interval)))",
          "legendFormat": "Review"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum((((pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"describe\"} - pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"describe\"} offset $__interval) >= 0) or (pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"describe\"} unless pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"describe\"} offset $__interval) or (pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"describe\"} < pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"describe\"} offset $__interval)))",
          "legendFormat": "Describe"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum((((pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"improve\"} - pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"improve\"} offset $__interval) >= 0) or (pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"improve\"} unless pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"improve\"} offset $__interval) or (pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"improve\"} < pr_agent_commands_total{ate_actor=\"__ACTOR__\",pr_agent_command=\"improve\"} offset $__interval)))",
          "legendFormat": "Suggest improvements"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Busy time",
      "description": "The agent is busy when the line is up. A flat line at the bottom means it is idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(pr_agent_commands_in_flight{ate_actor=\"__ACTOR__\"})",
          "legendFormat": "Commands running"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 15,
      "type": "row",
      "title": "Models and failures",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Model that answered over time",
      "description": "One row for each model. A coloured stretch means that the model answered commands in that time. A fallback model has its own row, in orange, named with (fallback). When you change the model of the agent, the old row stops and the new row starts. The row of a model is empty where it answered nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "mergeValues": true,
            "spanNulls": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "green",
                "value": 0.01
              }
            ]
          },
          "mappings": [],
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\(fallback\\)"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "alignValue": "center",
        "mergeValues": true,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(label_replace(sum by (model, fallback)((((pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"} - pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"} offset $__interval) >= 0) or (pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"} unless pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"} offset $__interval) or (pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"} < pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"} offset $__interval))), \"role\", \" (fallback)\", \"fallback\", \"true\"), \"role\", \"\", \"fallback\", \"false\") or (label_replace(vector(0), \"model\", \"No command answered yet\", \"\", \"\") unless sum(last_over_time(pr_agent_commands_by_model_total{ate_actor=\"__ACTOR__\"}[$__range])))",
          "legendFormat": "{{model}}{{role}}"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Failed commands over time",
      "description": "Commands that failed, in bars. A failed command had an error that pr-agent caught, or returned no result. An empty chart means no failures. A bar covers the time slice that ends at its right edge.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "noValue": "0",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "barAlignment": -1,
            "axisSoftMax": 3,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum((((pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"} - pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"} offset $__interval) >= 0) or (pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"} unless pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"} offset $__interval) or (pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"} < pr_agent_commands_finished_total{ate_actor=\"__ACTOR__\",outcome=\"failed\"} offset $__interval))) or vector(0)",
          "legendFormat": "Failed"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 16,
      "type": "row",
      "title": "Details",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Models that answered",
      "description": "Each model that answered a command in the time range at the top right of the dashboard, and how many commands it answered. Role says whether it was the main model of the agent or a fallback model that took over because the main model failed or timed out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Role"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "false": {
