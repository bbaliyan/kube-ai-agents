{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "controlPlaneNamespace": {
      "type": "string"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "atespace": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          }
        },
        "required": [
          "atespace",
          "namespace"
        ]
      }
    }
  }
}
